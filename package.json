{
  "name": "clif",
  "version": "1.0.0",
  "private": true,
  "description": "Clifton Campbell's personal site: projects, work history and a globe",
  "engines": {
    "node": ">=22.18 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/check-env.mts --dev && next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "node scripts/check-env.mts && next build",
    "start": "next start",
    "preprocess": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON makeHistoryData/index.mts",
    "images": "node scripts/optimize-images.mts",
    "lint": "eslint \"{pagesComponents,components,constants,hooks,modules,pages,styles,utils,makeHistoryData,scripts,types}/**/*.{js,jsx,ts,tsx,mts}\" \"*.{ts,mts,mjs}\"",
    "lint:fix": "eslint --fix \"{pagesComponents,components,constants,hooks,modules,pages,styles,utils,makeHistoryData,scripts,types}/**/*.{js,jsx,ts,tsx,mts}\" \"*.{ts,mts,mjs}\"",
    "format": "prettier --write \"*/**/*.{js,jsx,ts,tsx,mts}\" \"!public/**\" \"!node_modules/**\" \"!.next/**\" \"!.vercel/**\" \"!.vscode/**\"",
    "prepare": "husky",
    "test": "pnpm run test:e2e",
    "test:e2e": "node scripts/smoke.mts"
  },
  "repository": "git+https://github.com/mimio/clif.git",
  "author": "Clifton Campbell <clif@mimio.io>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mimio/clif/issues"
  },
  "homepage": "https://github.com/mimio/clif#readme",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@react-spring/web": "^10.1.2",
    "@redux-devtools/extension": "^4.0.0",
    "@use-gesture/react": "^10.3.1",
    "d3": "^7.9.0",
    "facepaint": "^1.2.1",
    "hex-to-rgba": "^2.0.1",
    "is-touch-device": "^1.0.1",
    "mapbox-gl": "^3.30.0",
    "next": "^16.3.5",
    "normalize.css": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.3.0",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/env": "16.3.5",
    "@svgr/webpack": "^8.1.0",
    "@turf/bbox": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@types/d3": "^7.4.3",
    "@types/facepaint": "^1.2.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "glslify-loader": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
