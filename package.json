{
  "name": "clif",
  "version": "1.0.0",
  "private": true,
  "description": "Clifton Campbell's personal site: projects, work history and a globe",
  "engines": {
    "node": ">=22.18 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/check-env.mts --dev && next dev",
    "specimens": "NEXT_PUBLIC_SPECIMENS=1 next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "node scripts/check-env.mts && next build",
    "start": "next start",
    "images": "node scripts/optimize-images.mts",
    "lint": "eslint \"{pagesComponents,components,content,pages,scene,styles,test,utils,e2e,scripts,types}/**/*.{js,jsx,ts,tsx,mts}\" \"*.{ts,mts,mjs}\"",
    "lint:fix": "eslint --fix \"{pagesComponents,components,content,pages,scene,styles,test,utils,e2e,scripts,types}/**/*.{js,jsx,ts,tsx,mts}\" \"*.{ts,mts,mjs}\"",
    "format": "prettier --write \"*/**/*.{js,jsx,ts,tsx,mts,css}\" \"!public/**\" \"!node_modules/**\" \"!.next/**\" \"!.vercel/**\" \"!.vscode/**\"",
    "prepare": "husky",
    "test": "vitest run && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "repository": "git+https://github.com/mimio/clif.git",
  "author": "Clifton Campbell <clif@mimio.io>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mimio/clif/issues"
  },
  "homepage": "https://github.com/mimio/clif#readme",
  "dependencies": {
    "clsx": "^2.1.1",
    "mapbox-gl": "^3.30.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/env": "16.3.5",
    "@playwright/test": "^1.63.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "glslify-loader": "^2.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "raw-loader": "^4.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
