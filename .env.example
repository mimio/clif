# Copy to .env.local for local development. On Vercel these live in the
# project's Environment Variables (Production, Preview and Development).

# Public Mapbox token (pk.…) for the globe, which is on every route.
# Required for `pnpm build`; `pnpm dev` only warns and falls back to a
# token-less scene. Inlined at build time, so restrict it to the site's
# domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Mapbox style the scene loads. Optional, defaults to the value below, and
# best left unset: Mapbox Standard is the only style this site can theme.
# The eight themes are applied at runtime through Standard's `basemap`
# import, and mapbox-gl answers those calls on a style without one by
# returning -- no throw, no warning, no error event -- so any other style
# gives a globe that looks fine and wears none of the themes. See the README.
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/standard

# The site's canonical origin, with no trailing slash, e.g.
# https://clif.mimio.io. Optional: with nothing set, the canonical link and
# the og:/twitter: URLs stay root-relative, which resolves correctly against
# whatever document served them -- so previews and localhost are right, and
# only the deployed site is missing an absolute canonical. Set it in the
# Vercel project (Production at least) to get one.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement id, optional. Analytics is a no-op without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
