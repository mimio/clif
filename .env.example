# Copy to .env.local for local development. On Vercel these live in the
# project's Environment Variables (Production, Preview and Development).

# Public Mapbox token (pk.…) for the history map, required. Inlined at build
# time; restrict it to the site's domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Analytics 4 measurement id, optional. Analytics is a no-op without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
