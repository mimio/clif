# Copy to .env.local for local development. On Vercel these live in the
# project's Environment Variables (Production, Preview and Development).

# Public Mapbox token (pk.…) for the globe, which is on every route.
# Required for `pnpm build`; `pnpm dev` only warns and falls back to a
# token-less scene. Inlined at build time, so restrict it to the site's
# domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Mapbox style the scene loads. Optional; defaults to the value below.
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/standard

# Google Analytics 4 measurement id, optional. Analytics is a no-op without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
